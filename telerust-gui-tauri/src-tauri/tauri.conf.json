{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "telerust",
  "version": "0.1.0",
  "identifier": "com.telerust.app",
  "build": {
    "beforeDevCommand": "npx serve ../frontend -p 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "telerust",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}